{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@moritzbrantner/timeline-editor": ["./src/index.ts"],
      "@moritzbrantner/timeline-editor/core": ["./src/core.ts"],
      "@moritzbrantner/timeline-editor/react": ["./src/react.tsx"],
      "@moritzbrantner/timeline-editor/extensions": ["./src/extensions.ts"],
      "@moritzbrantner/timeline-editor/media-types": ["./src/media-types.ts"],
      "@moritzbrantner/timeline-editor/media-import": ["./src/media-import.ts"],
      "@moritzbrantner/timeline-editor/text": ["./src/text.ts"],
      "@moritzbrantner/timeline-editor/audio": ["./src/audio.ts"],
      "@moritzbrantner/timeline-editor/video": ["./src/video.ts"],
      "@moritzbrantner/timeline-editor/image": ["./src/image.ts"],
      "@moritzbrantner/timeline-editor/data": ["./src/data.ts"],
      "@timeline-editor/compute": ["./packages/compute/src/index.ts"],
      "@timeline-editor/audio": ["./packages/audio/src/index.ts"],
      "@timeline-editor/video": ["./packages/video/src/index.ts"],
      "@timeline-editor/image": ["./packages/image/src/index.ts"],
      "@timeline-editor/captions": ["./packages/captions/src/index.ts"],
      "@timeline-editor/geo": ["./packages/geo/src/index.ts"],
      "@timeline-editor/data": ["./packages/data/src/index.ts"],
      "@timeline-editor/tauri": ["./packages/tauri/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "packages/**/*.ts"]
}
