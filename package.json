{
  "name": "@moritzbrantner/timeline-editor",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*"
  ],
  "homepage": "https://github.com/moritzbrantner/timeline-editor#readme",
  "bugs": {
    "url": "https://github.com/moritzbrantner/timeline-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzbrantner/timeline-editor.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "source": "./src/core.ts",
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./react": {
      "source": "./src/react.tsx",
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./commands": {
      "source": "./src/commands.ts",
      "types": "./dist/commands.d.ts",
      "import": "./dist/commands.js"
    },
    "./history": {
      "source": "./src/history.ts",
      "types": "./dist/history.d.ts",
      "import": "./dist/history.js"
    },
    "./serialization": {
      "source": "./src/serialization.ts",
      "types": "./dist/serialization.d.ts",
      "import": "./dist/serialization.js"
    },
    "./extensions": {
      "source": "./src/extensions.ts",
      "types": "./dist/extensions.d.ts",
      "import": "./dist/extensions.js"
    },
    "./media-types": {
      "source": "./src/media-types.ts",
      "types": "./dist/media-types.d.ts",
      "import": "./dist/media-types.js"
    },
    "./media-import": {
      "source": "./src/media-import.ts",
      "types": "./dist/media-import.d.ts",
      "import": "./dist/media-import.js"
    },
    "./text": {
      "source": "./src/text.ts",
      "types": "./dist/text.d.ts",
      "import": "./dist/text.js"
    },
    "./audio": {
      "source": "./src/audio.ts",
      "types": "./dist/audio.d.ts",
      "import": "./dist/audio.js"
    },
    "./video": {
      "source": "./src/video.ts",
      "types": "./dist/video.d.ts",
      "import": "./dist/video.js"
    },
    "./image": {
      "source": "./src/image.ts",
      "types": "./dist/image.d.ts",
      "import": "./dist/image.js"
    },
    "./data": {
      "source": "./src/data.ts",
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@moenarch/editor-core": "git+https://github.com/moritzbrantner/editor-core.git#a539abfda7a9cc7bd4633e7e415189551930d95d",
    "@moritzbrantner/ui": "git+https://github.com/moritzbrantner/ui.git#2f0cc4e470307b017fb06aae4a03b9abce47cc8c"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@moritzbrantner/input-bindings": "git+https://github.com/moritzbrantner/input-bindings.git#68f5a33171c958752971ab50ff3fc81f6431d8e0",
    "@moritzbrantner/input-bindings-react": "git+https://github.com/moritzbrantner/input-bindings.git#6f29eea4743fc2d199ad3fa67a3886d687b8b504",
    "@moritzbrantner/input-bindings-runtime": "git+https://github.com/moritzbrantner/input-bindings.git#4f6afa966bd2829c02ec61edad5858c84bbdbb70",
    "@moritzbrantner/input-bindings-web": "git+https://github.com/moritzbrantner/input-bindings.git#181bf4cd75277008b0d61b72976592b99775101e",
    "@moritzbrantner/settings-browser": "git+https://github.com/moritzbrantner/settings.git#27904ae572800f7d343c31d5177cfc6cf8c74706",
    "@playwright/test": "1.65.0",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@storybook/builder-vite": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "4.1.12",
    "jsdom": "29.1.1",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "playwright": "1.65.0",
    "playwright-core": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.6",
    "tailwindcss": "4.3.5",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "unlighthouse": "0.19.1",
    "vite": "8.3.6",
    "vitest": "4.1.12"
  },
  "trustedDependencies": [
    "@moenarch/editor-core",
    "@moritzbrantner/ui"
  ],
  "overrides": {
    "@moritzbrantner/ui": "git+https://github.com/moritzbrantner/ui.git#2f0cc4e470307b017fb06aae4a03b9abce47cc8c"
  },
  "scripts": {
    "build": "tsup src/index.ts src/core.ts src/react.tsx src/commands.ts src/history.ts src/serialization.ts src/extensions.ts src/media-types.ts src/media-import.ts src/text.ts src/audio.ts src/video.ts src/image.ts src/data.ts --format esm --dts --clean --out-dir dist",
    "build:packages": "bun run build && (cd packages/compute && bun run build) && for package in packages/*; do if [ -f \"$package/package.json\" ] && [ \"$package\" != \"packages/compute\" ]; then (cd \"$package\" && bun run build); fi; done",
    "build:wasm": "cargo build --workspace --target wasm32-unknown-unknown",
    "build-storybook": "storybook build",
    "build:pages": "vite build --config examples/dev/vite.config.ts --base /timeline-editor/ --outDir ../../dist-pages --emptyOutDir && TIMELINE_STORYBOOK_BASE=/timeline-editor/storybook/ storybook build --output-dir dist-pages/storybook",
    "dev": "vite --config examples/dev/vite.config.ts --host 127.0.0.1",
    "dev:source": "bun run source:prepare && bun run dev",
    "source:verify-graph": "bash scripts/source-deps verify-graph",
    "source:prepare": "bash scripts/source-deps prepare",
    "source:status": "bash scripts/source-deps status",
    "source:smoke": "bash scripts/source-deps smoke",
    "source:restore": "bash scripts/source-deps restore",
    "registry:restore": "bun run source:restore",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --format=github",
    "prepack": "bun run build",
    "prepare": "bun ./scripts/prepare-git-install.ts",
    "verify:git-install": "bun ./scripts/verify-git-install.ts",
    "check-types": "tsc --noEmit",
    "check-examples": "tsc -p tests/examples/tsconfig.json",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "test": "vitest run --config vitest.workspace.ts",
    "test:packages": "vitest run --config vitest.config.ts $(find packages -name '*.test.ts')",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:rust": "cargo test --workspace",
    "test:integration": "vitest run --config vitest.storybook.config.ts",
    "test:dependency-resolution": "node ./tests/package/dependency-resolution.mjs",
    "test:package": "node ./tests/package/boundary.mjs && bun run build:packages && node ./tests/package/export-contract.mjs && node ./tests/package/smoke.mjs",
    "update:export-contract": "UPDATE_EXPORT_CONTRACT=1 node ./tests/package/export-contract.mjs",
    "test:a11y": "playwright test src/react/workbench/workbench-a11y.playwright.spec.ts",
    "test:lighthouse": "node ./tests/performance/run-unlighthouse.mjs",
    "bench:scrub": "node ./tests/performance/scrub-benchmark.mjs",
    "test:playwright": "playwright test",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "test:regression": "playwright test src/react/workbench/workbench-basic-regressions.playwright.spec.ts",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "verify:checks": "bun run format:check && bun run lint && bun run check-types && bun run test && bun run test:packages && bun run test:rust && bun run test:playwright && bun run test:lighthouse && bun run build-storybook && bun run build && bun run build:packages && bun run build:wasm && bun run check-examples && bun run test:package",
    "verify:source": "bun run source:verify-graph && bun run source:prepare && bun run source:smoke && bun run verify:quick && bun run build && bun run build:packages && bun run check-examples",
    "verify:registry": "bun run registry:restore && bun run verify:checks",
    "verify": "bun run verify:registry",
    "verify:quick": "bun run check-types && bun run test:unit && bun run test:packages && bun run test:rust && bun run test:regression"
  }
}
