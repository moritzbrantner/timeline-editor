{
  "name": "@moritzbrantner/timeline-editor",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "packageManager": "bun@1.3.12",
  "homepage": "https://github.com/moritzbrantner/timeline-editor#readme",
  "bugs": {
    "url": "https://github.com/moritzbrantner/timeline-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzbrantner/timeline-editor.git"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./commands": {
      "types": "./dist/commands.d.ts",
      "import": "./dist/commands.js"
    },
    "./history": {
      "types": "./dist/history.d.ts",
      "import": "./dist/history.js"
    },
    "./serialization": {
      "types": "./dist/serialization.d.ts",
      "import": "./dist/serialization.js"
    },
    "./media-types": {
      "types": "./dist/media-types.d.ts",
      "import": "./dist/media-types.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "import": "./dist/text.js"
    },
    "./audio": {
      "types": "./dist/audio.d.ts",
      "import": "./dist/audio.js"
    },
    "./video": {
      "types": "./dist/video.d.ts",
      "import": "./dist/video.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "import": "./dist/image.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@moritzbrantner/ui": "^0.8.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.29.7",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/builder-vite": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/browser-playwright": "^4.1.7",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "playwright": "^1.60.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.4.1",
    "tsup": "^8.5.0",
    "typescript": "6.0.2",
    "unlighthouse": "0.17.9",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/core.ts src/react.tsx src/commands.ts src/history.ts src/serialization.ts src/media-types.ts src/text.ts src/audio.ts src/video.ts src/image.ts src/data.ts --format esm --dts --clean --out-dir dist",
    "build-storybook": "storybook build",
    "changeset": "changeset",
    "dev": "vite --config examples/dev/vite.config.ts --host 127.0.0.1",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --format=github",
    "prepack": "bun run build",
    "check-types": "tsc --noEmit",
    "check-examples": "tsc --ignoreConfig --noEmit --jsx react-jsx --module ESNext --moduleResolution Bundler --target ES2022 --strict --skipLibCheck tests/examples/*.tsx",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "test": "vitest run --config vitest.workspace.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.storybook.config.ts",
    "test:package": "bun run build && node ./tests/package/smoke.mjs",
    "test:a11y": "playwright test src/react/workbench/workbench-a11y.playwright.spec.ts",
    "test:lighthouse": "node ./tests/performance/run-unlighthouse.mjs",
    "test:playwright": "playwright test",
    "test:regression": "playwright test src/react/workbench/workbench-basic-regressions.playwright.spec.ts",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "verify": "bun run format:check && bun run lint && bun run check-types && bun run test && bun run test:playwright && bun run test:lighthouse && bun run build-storybook && bun run build && bun run check-examples && bun run test:package",
    "verify:quick": "bun run check-types && bun run test:unit && bun run test:regression"
  }
}
