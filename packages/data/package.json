{
  "name": "@timeline-editor/data",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/worker.ts --format esm --dts --clean --out-dir dist",
    "test": "vitest run src/**/*.test.ts"
  },
  "dependencies": {
    "@timeline-editor/compute": "workspace:*"
  },
  "peerDependencies": {
    "@moritzbrantner/timeline-editor": "^1.0.0",
    "react": "^19.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.7"
  }
}
